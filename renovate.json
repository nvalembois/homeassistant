{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions",
    "docker:pinDigests",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchFileNames": ["Dockerfile"],
      "groupName": "homeassistant"
    },
    {
      "matchDatasources": ["github-tags"],
      "groupName": "githubCi"
    },
    {
      "description": "Rester sur Python < 3.15 (guppy3 incompatible)",
      "matchPackageNames": [
        "python",
        "docker.io/library/python",
        "actions/python-versions"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
